# Neon pooled PostgreSQL URL, including sslmode=require. Never commit real values.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Seed only; use a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional LOCAL development database; never use on Vercel.
PGLITE_DATA_DIR=
# Private Vercel Blob read/write token for company logos, proofs and references.
# Configure securely; never commit a real token or use a NEXT_PUBLIC_ variable.
BLOB_READ_WRITE_TOKEN=
